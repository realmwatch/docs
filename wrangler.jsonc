// Static-assets-only Worker: no script, Cloudflare serves ./dist directly.
// Deployed by Cloudflare Workers Builds on every push to main (see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realmwatch-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get Starlight's 404 page with a real 404 status.
    "not_found_handling": "404-page",
    // Pages are built as /path/index.html and linked as /path/.
    "html_handling": "auto-trailing-slash"
  }
  // TODO(domain): once the docs domain is chosen, attach it here, e.g.
  //   "routes": [{ "pattern": "docs.example.com", "custom_domain": true }],
  // and set `site` in astro.config.mjs to the same URL. Until then the site
  // is served on its *.workers.dev URL.
}
