// Static-assets-only Worker: no script, Cloudflare serves ./dist directly.
// Deployed by Cloudflare Workers Builds on every push to main (see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realmwatch-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get Starlight's 404 page with a real 404 status.
    "not_found_handling": "404-page",
    // Pages are built as /path/index.html and linked as /path/.
    "html_handling": "auto-trailing-slash"
  },
  // Keep in sync with `site` in astro.config.mjs.
  "routes": [{ "pattern": "docs.realmwatch.dev", "custom_domain": true }]
}
